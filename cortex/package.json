{
  "name": "cortex",
  "version": "1.0.0",
  "description": "Local interface for orchestrating AI agent workflows",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run build && tsx src/back/infrastructure/web/controller/server.ts --open",
    "start:server": "npm run build && tsx src/back/infrastructure/web/controller/server.ts",
    "dev": "tsx watch src/back/infrastructure/web/controller/server.ts",
    "dev:web": "vite",
    "build": "vite build",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "preview": "vite preview"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.9",
    "express": "^5.2.1",
    "lucide-react": "^1.29.0",
    "multer": "^2.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "smol-toml": "^1.7.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
